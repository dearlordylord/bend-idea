<idea-plugin url="https://github.com/dearlordylord/bend-idea">
    <id>com.dearlordylord.bend.idea</id>
    <name>Bend2</name>
    <vendor url="https://github.com/dearlordylord/bend-idea">dearlordylord</vendor>
    <description><![CDATA[
Language support for <a href="https://github.com/bendlang/bend">Bend 2</a> in IntelliJ IDEA.

<ul>
  <li>Syntax highlighting, hash line comments, and editable snippets</li>
  <li>Completion, parameter information, parameter hints, constructor-case generation, and explicit imports</li>
  <li>Go to Declaration, Go to Symbol, Find Usages, static dependency inspection, and source Quick Documentation</li>
  <li>Manual and optional background compiler checking of unsaved source and imports</li>
  <li>Selectable proof roots, law/fill navigation, proof progress, Run and Build configurations</li>
  <li>Foreign source paths, previewable file refactoring, templates, and optional IDE spelling assistance</li>
</ul>

Editing works without a Bend installation. Checking requires a configured Bend compiler with
<code>--check-only</code> support. See the
<a href="https://github.com/dearlordylord/bend-idea#readme">README</a> for setup and current limitations.
    ]]></description>
    <change-notes><![CDATA[
<p>Version 0.1.4:</p>
<ul>
  <li>Add a Bend structure view, source-preserving formatting, and binding-aware rename</li>
  <li>Search workspace declarations with Go to Symbol</li>
  <li>Make compiler checks more reliable with pinned offline test inputs, current-only results, conservative verdicts, and exact imported-source mapping</li>
  <li>Remove IntelliJ Internal API usages reported by Plugin Verifier</li>
</ul>
    ]]></change-notes>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="com.dearlordylord.bend.idea-spellchecker.xml">tanvd.grazi</depends>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.dearlordylord.bend.idea.adapters.intellij.BendCheckingStartup"/>
        <toolWindow id="Bend Proof Progress"
                    anchor="right"
                    factoryClass="com.dearlordylord.bend.idea.features.proofs.BendProofProgressToolWindowFactory"/>
        <configurationType implementation="com.dearlordylord.bend.idea.features.execution.BendRunConfigurationType"/>
        <fileType name="Bend" language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.syntax.BendFileType"
                  extensions="bend"/>
        <lang.parserDefinition language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.syntax.BendParserDefinition"/>
        <stubElementTypeHolder class="com.dearlordylord.bend.idea.syntax.psi.BendStubElementTypes"
                               externalIdPrefix="bend."/>
        <stubIndex implementation="com.dearlordylord.bend.idea.symbols.index.BendSymbolNameIndex"/>
        <stubIndex implementation="com.dearlordylord.bend.idea.symbols.index.BendDottedComponentIndex"/>
        <gotoSymbolContributor implementation="com.dearlordylord.bend.idea.symbols.index.BendChooseByNameContributor"/>
        <additionalLibraryRootsProvider implementation="com.dearlordylord.bend.idea.symbols.index.BendSymbolLibraryRootsProvider"/>
        <lang.formatter language="Bend"
                        implementationClass="com.dearlordylord.bend.idea.features.formatting.BendFormattingModelBuilder"/>
        <lang.syntaxHighlighterFactory language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.syntax.lexer.BendSyntaxHighlighterFactory"/>
        <annotator language="Bend"
                   implementationClass="com.dearlordylord.bend.idea.features.editing.BendSemanticAnnotator"/>
        <annotator language="Bend"
                   implementationClass="com.dearlordylord.bend.idea.features.completion.BendUnresolvedCallAnnotator"/>
        <colorSettingsPage implementation="com.dearlordylord.bend.idea.syntax.lexer.BendColorSettingsPage"/>
        <lang.commenter language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.editing.BendCommenter"/>
        <braceMatcher filetype="Bend"
                      implementationClass="com.dearlordylord.bend.idea.features.editing.BendContextBraceMatcher"/>
        <lang.psiStructureViewFactory language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.editing.BendStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="com.dearlordylord.bend.idea.features.editing.BendBreadcrumbsProvider"/>
        <extendWordSelectionHandler implementation="com.dearlordylord.bend.idea.features.editing.BendSelectionHandler"/>
        <lang.foldingBuilder language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.editing.BendFoldingBuilder"/>
        <typedHandler implementation="com.dearlordylord.bend.idea.features.editing.BendTypedHandler"/>
        <backspaceHandlerDelegate order="first"
                                  implementation="com.dearlordylord.bend.idea.features.editing.BendBackspaceHandler"/>
        <editorFactoryListener implementation="com.dearlordylord.bend.idea.features.editing.BendEditorRelease"/>
        <enterHandlerDelegate implementation="com.dearlordylord.bend.idea.features.editing.BendEnterHandler"/>
        <fileTypeIndentOptionsProvider implementation="com.dearlordylord.bend.idea.features.editing.BendIndentOptionsProvider"/>
        <completion.contributor language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.completion.BendCompletionContributor"/>
        <lang.documentationProvider language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.documentation.BendDocumentationProvider"/>
        <codeInsight.parameterInfo language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.signatures.BendParameterInfoHandler"/>
        <codeInsight.parameterNameHints language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.signatures.BendParameterNameHintsProvider"/>
        <codeInsight.lineMarkerProvider language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.proofs.BendProofLineMarkerProvider"/>
        <lang.findUsagesProvider language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.navigation.BendFindUsagesProvider"/>
        <renamePsiElementProcessor implementation="com.dearlordylord.bend.idea.features.rename.BendLocalRenameProcessor"/>
        <renamePsiElementProcessor implementation="com.dearlordylord.bend.idea.features.rename.BendDeclarationRenameProcessor"/>
        <renamePsiElementProcessor implementation="com.dearlordylord.bend.idea.features.rename.BendSourceFileRenameProcessor"/>
        <moveFileHandler implementation="com.dearlordylord.bend.idea.features.rename.BendMoveFileHandler"/>
        <referencesSearch implementation="com.dearlordylord.bend.idea.symbols.references.BendUsageSearch"/>
        <psi.referenceContributor language="Bend"
                  implementation="com.dearlordylord.bend.idea.symbols.references.BendReferenceContributor"/>
        <externalAnnotator language="Bend"
                           implementationClass="com.dearlordylord.bend.idea.features.checking.BendCheckAnnotator"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.analysis.api.BendCheckService"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendCheckSession"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.analysis.api.BendExplicitCheckRunner"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendExplicitCheckRunnerService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.features.execution.api.BendExecutionProcessFactory"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.process.BendExecutionProcessService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.features.execution.api.BendBuildProcessFactory"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.process.BendBuildProcessService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.features.execution.api.BendNativeProcessFactory"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.process.BendNativeProcessService"/>
        <projectService serviceImplementation="com.dearlordylord.bend.idea.features.proofs.BendProofRootStore"/>
        <projectService serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendBackgroundChecking"/>
        <applicationService serviceInterface="com.dearlordylord.bend.idea.toolchain.api.BendToolchainSettings"
                            serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendSettingsStorage"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendLibrarySource"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendLibrarySourceService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendSourceCatalog"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendLibrarySourceService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendWorkspacePaths"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendLibrarySourceService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendWorkspaceGraph"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendWorkspaceGraphService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendLoadingConfiguration"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendLoadingConfigurationService"/>
        <projectService serviceImplementation="com.dearlordylord.bend.idea.symbols.api.BendBaseSymbolCatalog"/>
        <projectService serviceImplementation="com.dearlordylord.bend.idea.symbols.api.BendImportedSymbolCatalog"/>
        <applicationConfigurable instance="com.dearlordylord.bend.idea.features.settings.BendSettingsConfigurable"
                                 id="com.dearlordylord.bend.idea.settings" displayName="Bend" parentId="language"/>
        <notificationGroup id="Bend" displayType="BALLOON"/>
    </extensions>
    <actions>
        <group id="Bend.Tools" text="Bend" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <action id="Bend.CheckCurrentFile"
                class="com.dearlordylord.bend.idea.features.checking.BendCheckCurrentFileAction"
                text="Check Current Bend File" description="Check the current Bend document without running main">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.CheckProofRoot"
                class="com.dearlordylord.bend.idea.features.proofs.BendCheckProofRootAction"
                text="Check Bend Proof Root" description="Select and check a persisted Bend proof root">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.NextProofHole"
                class="com.dearlordylord.bend.idea.features.proofs.BendNextHoleAction"
                text="Next Bend Proof Hole" description="Navigate to the next named or TODO hole">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.PreviousProofHole"
                class="com.dearlordylord.bend.idea.features.proofs.BendPreviousHoleAction"
                text="Previous Bend Proof Hole" description="Navigate to the previous named or TODO hole">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.GenerateMatchCases"
                class="com.dearlordylord.bend.idea.features.editing.BendGenerateMatchCasesAction"
                text="Generate Match Cases" description="Append missing cases for a uniquely resolved datatype binder">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.GenerateLawFill"
                class="com.dearlordylord.bend.idea.features.proofs.BendGenerateLawFillAction"
                text="Generate Bend Law Fill" description="Insert an incomplete law-fill skeleton into a selected proof root">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.CheckStatus"
                class="com.dearlordylord.bend.idea.features.checking.BendCheckStatusAction"
                text="Bend Check Status" description="Show the current Bend check state">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.ExplicitImport"
                class="com.dearlordylord.bend.idea.features.completion.BendExplicitImportAction"
                text="Import Bend Symbol at Caret"
                description="Choose a workspace declaration and add an explicit Bend import">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.InspectDependencies"
                class="com.dearlordylord.bend.idea.features.navigation.BendInspectDependenciesAction"
                text="Inspect Bend Dependencies"
                description="Show direct resolved calls and module imports around the caret">
            <add-to-group group-id="Bend.Tools" anchor="last"/>
        </action>
        <action id="Bend.CreateModule"
                class="com.dearlordylord.bend.idea.features.templates.BendCreateModuleAction"
                text="New Bend Module" description="Create an editable Bend source file from the module template"
                icon="/icons/bend.svg">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <action id="Bend.CreateLawProofPair"
                class="com.dearlordylord.bend.idea.features.templates.BendCreateLawProofPairAction"
                text="New Bend Law and Proof Pair" description="Create sibling LAWS.bend and PROOF.bend files"
                icon="/icons/bend.svg">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
