<idea-plugin>
    <id>com.dearlordylord.bend.idea</id>
    <name>Bend2</name>
    <vendor url="https://github.com/dearlordylord/bend-idea">dearlordylord</vendor>
    <description><![CDATA[
        Native Bend 2 language support with highlighting, line comments,
        keyword completion and editable snippets.
        Editing support loads without a Bend installation.
    ]]></description>
    <change-notes><![CDATA[
<p>Version 0.1.1:</p>
<ul>
  <li>Navigate to an imported Bend module from its import path</li>
  <li>Allow installation on newer IntelliJ IDEA builds; verified with IDEA Ultimate 2026.1</li>
</ul>
    ]]></change-notes>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.dearlordylord.bend.idea.adapters.intellij.BendCheckingStartup"/>
        <fileType name="Bend" language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.syntax.BendFileType"
                  extensions="bend"/>
        <lang.parserDefinition language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.syntax.BendParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.syntax.lexer.BendSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.dearlordylord.bend.idea.syntax.lexer.BendColorSettingsPage"/>
        <lang.commenter language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.editing.BendCommenter"/>
        <completion.contributor language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.completion.BendCompletionContributor"/>
        <lang.documentationProvider language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.documentation.BendDocumentationProvider"/>
        <lang.findUsagesProvider language="Bend"
                  implementationClass="com.dearlordylord.bend.idea.features.navigation.BendFindUsagesProvider"/>
        <referencesSearch implementation="com.dearlordylord.bend.idea.symbols.references.BendUsageSearch"/>
        <psi.referenceContributor language="Bend"
                  implementation="com.dearlordylord.bend.idea.symbols.references.BendReferenceContributor"/>
        <externalAnnotator language="Bend"
                           implementationClass="com.dearlordylord.bend.idea.features.checking.BendCheckAnnotator"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.analysis.api.BendCheckService"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendCheckSession"/>
        <projectService serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendBackgroundChecking"/>
        <applicationService serviceInterface="com.dearlordylord.bend.idea.toolchain.api.BendToolchainSettings"
                            serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendSettingsStorage"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendLibrarySource"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendLibrarySourceService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.ports.BendSourceCatalog"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendLibrarySourceService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendWorkspacePaths"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendLibrarySourceService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendWorkspaceGraph"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendWorkspaceGraphService"/>
        <projectService serviceInterface="com.dearlordylord.bend.idea.workspace.api.BendLoadingConfiguration"
                        serviceImplementation="com.dearlordylord.bend.idea.adapters.intellij.BendLoadingConfigurationService"/>
        <projectService serviceImplementation="com.dearlordylord.bend.idea.symbols.api.BendBaseSymbolCatalog"/>
        <projectService serviceImplementation="com.dearlordylord.bend.idea.symbols.api.BendImportedSymbolCatalog"/>
        <applicationConfigurable instance="com.dearlordylord.bend.idea.features.settings.BendSettingsConfigurable"
                                 id="com.dearlordylord.bend.idea.settings" displayName="Bend"/>
    </extensions>
    <actions>
        <action id="Bend.CheckCurrentFile"
                class="com.dearlordylord.bend.idea.features.checking.BendCheckCurrentFileAction"
                text="Check Current Bend File" description="Check the current Bend document without running main">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Bend.CheckStatus"
                class="com.dearlordylord.bend.idea.features.checking.BendCheckStatusAction"
                text="Bend Check Status" description="Show the current Bend check state">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
